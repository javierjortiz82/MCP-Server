# Demo Agent Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Update values with your actual configuration
# 3. NEVER commit .env to git (it contains secrets)
# 4. This file is for LOCAL DEVELOPMENT only
# 5. Docker uses environment variables from docker-compose.yml
#
# SECURITY NOTE: All secrets (API keys, passwords) should be:
# - Never committed to git
# - Loaded from environment variables in production
# - Rotated regularly
# - Not logged or printed in debug output

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection string for demo_agent tables
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://mcp_user:mcp_password@localhost:5434/mcpdb

# PostgreSQL schema name (namespace for demo tables)
# Contains: demo_users, demo_otp_codes, demo_usage, demo_audit_log, demo_sessions
SCHEMA_NAME=test

# ============================================================================
# Gemini API Configuration
# ============================================================================
# REQUIRED: Google API Key for Gemini (get from https://console.cloud.google.com)
# Must start with "AIza" - DO NOT COMMIT: This is a secret key
GOOGLE_API_KEY=AIzaSyBu1JHchLA4TAhp9YHbdrr19-odUDEbNXI

# Gemini model to use (gemini-2.5-flash recommended)
MODEL=gemini-2.5-flash

# Model temperature (0.0-2.0: 0=deterministic, 2=creative)
TEMPERATURE=0.2

# Maximum tokens for Gemini output
MAX_OUTPUT_TOKENS=2048

# ============================================================================
# Demo Limits Configuration
# ============================================================================
# Maximum tokens per user per day (5000 = ~50-100 queries)
DEMO_MAX_TOKENS=5000

# Hours to wait before reactivating blocked users (24 hours typical)
DEMO_COOLDOWN_HOURS=24

# Warning threshold when user reaches X% of quota
DEMO_WARNING_THRESHOLD=85

# ============================================================================
# OTP (One-Time Password) Configuration - SECURITY SETTINGS
# ============================================================================
# SECURITY: Following NIST SP 800-63B & OWASP standards
# Reference: https://pages.nist.gov/800-63-3/

# OTP expiration time in minutes (NIST: 5-15 minutes recommended)
# Security: 24+ hours enables brute force attacks
# UX: Too short (2-3 min) frustrates users
# RECOMMENDED: 10 minutes (balanced)
OTP_EXPIRATION_MINUTES=10

# Seconds to wait between OTP requests per email (rate limiting)
# Prevents spam: users must wait before requesting new code
# Typical: 60 seconds (1 minute between requests)
OTP_RATE_LIMIT_COOLDOWN_SECONDS=60

# Maximum verification attempts per OTP code (prevents brute force)
# After X failed attempts, OTP becomes invalid
# 6-digit code = 1 million combinations
# 3 attempts with rate limiting = secure against automated attacks
OTP_MAX_ATTEMPTS=3

# ============================================================================
# Server Configuration
# ============================================================================
# Host to bind to (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
DEMO_AGENT_HOST=0.0.0.0

# Port to listen on (must not conflict with other services)
DEMO_AGENT_PORT=8082

# ============================================================================
# Security Configuration
# ============================================================================
# Enable reCAPTCHA v3 bot detection
ENABLE_CAPTCHA=true

# reCAPTCHA v3 Secret Key (server-side) - DO NOT COMMIT
# Get from: https://console.cloud.google.com/security/recaptcha
RECAPTCHA_SECRET_KEY=6Lfe9gAsAAAAANve81zXifqSit1W5imIkCEkNbHr

# reCAPTCHA v3 Site Key (client-side)
# Get from: https://console.cloud.google.com/security/recaptcha
RECAPTCHA_SITE_KEY=6Lfe9gAsAAAAAMRlPzoDXhkGrqI3yGgiLcPyGJnM

# Enable client fingerprinting (device profiling)
ENABLE_FINGERPRINT=true

# Fingerprint abuse score threshold (0.0-1.0, 0.7 typical)
# Above threshold = trigger CAPTCHA
FINGERPRINT_SCORE_THRESHOLD=0.7

# ============================================================================
# Rate Limiting Configuration
# ============================================================================
# Maximum requests per IP per minute (prevents brute force)
IP_RATE_LIMIT_REQUESTS=100

# Rate limit window in seconds
IP_RATE_LIMIT_WINDOW_SEC=60

# ============================================================================
# Clerk Authentication Configuration
# ============================================================================
# Clerk Identity Provider - Used for OAuth/SSO authentication
# Get these from: https://dashboard.clerk.com -> API Keys

# Clerk Secret Key (server-side) - DO NOT COMMIT: This is a secret key
# Format: sk_test_... (development) or sk_live_... (production)
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Clerk Publishable Key (client-side, can be public)
# Format: pk_test_... (development) or pk_live_... (production)
CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Clerk Webhook Secret for validating webhook signatures
# Format: whsec_... (get from Clerk Dashboard -> Webhooks)
CLERK_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Clerk Frontend API domain (default: clerk.accounts.dev)
# For custom domains: your-domain.clerk.accounts.com
CLERK_FRONTEND_API=clerk.accounts.dev

# Enable Clerk authentication (set to false to use legacy auth only)
# If false, Clerk middleware will be bypassed
ENABLE_CLERK_AUTH=true

# ============================================================================
# CORS Configuration (Cross-Origin Resource Sharing)
# ============================================================================
# Controls which frontend domains can access the API
# SECURITY: Only add trusted domains to prevent unauthorized access

# Comma-separated list of allowed origins for CORS
# Examples:
#   Development: http://localhost:8080,http://localhost:3000
#   Staging:     https://staging.odiseo.com
#   Production:  https://app.odiseo.com,https://odiseo.com
# IMPORTANT: Do NOT use wildcards (*) in production - specify exact domains
CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:3000

# Allow credentials (cookies, authorization headers) in CORS requests
# Must be true for authenticated API requests
CORS_ALLOW_CREDENTIALS=true

# Allowed HTTP methods for CORS
# Use "*" for all methods, or specify: "GET,POST,PUT,DELETE,OPTIONS"
CORS_ALLOW_METHODS=*

# Allowed headers for CORS
# Use "*" for all headers, or specify: "Authorization,Content-Type"
# SECURITY: In production, consider specifying exact headers
CORS_ALLOW_HEADERS=*

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Whether to log to file
LOG_TO_FILE=true

# Directory for log files
LOG_DIR=logs

# Debug mode (extra verbose output)
DEBUG_MODE=false
