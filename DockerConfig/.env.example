# ============================================
# Docker Infrastructure Configuration Template
# ============================================
# This file contains ONLY Docker infrastructure variables
# (PostgreSQL, pgAdmin, Docker Compose settings)
#
# Each service has its own .env file:
#   - mcp_server/.env.example → mcp_server/.env
#   - agent/.env.example → agent/.env
#   - client_mcp/.env.example → client_mcp/.env
#   - email_service/.env.example → email_service/.env
#
# To use this file:
#   1. Copy to .env: cp DockerConfig/.env.example DockerConfig/.env
#   2. Update with your values
#   3. DO NOT add service-specific variables here
#
# WARNING: Do NOT commit .env to version control!
# ============================================

# ============================================
# PostgreSQL Configuration
# ============================================
# Database credentials for PostgreSQL container
POSTGRES_DB=mcpdb
POSTGRES_USER=mcp_user
# ⚠️ IMPORTANTE: Reemplaza mcp_password con una contraseña fuerte
#    Requisitos mínimos: 16+ caracteres, mayúsculas, minúsculas, números, símbolos
#    Ejemplo: MySecur3P@ssw0rd!2025
POSTGRES_PASSWORD=mcp_password
POSTGRES_PORT=5434

# ============================================
# pgAdmin Configuration
# ============================================
# Web UI for PostgreSQL administration
# Access at: http://localhost:{PGADMIN_PORT}
PGADMIN_EMAIL=admin@example.com
# ⚠️ IMPORTANTE: Reemplaza admin123 con una contraseña fuerte
#    Esta es la contraseña para acceder a pgAdmin (UI web)
#    Requisitos mínimos: 16+ caracteres, mayúsculas, minúsculas, números, símbolos
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=8090

# ============================================
# Docker Compose Configuration
# ============================================
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=docker-config
