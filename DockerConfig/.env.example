# ============================================
# Lab01 MCP - Environment Configuration Template
# ============================================
# This is a template file. Copy to .env and update with your actual values.
# DO NOT commit .env file to version control - it contains sensitive data!
#
# Usage:
#   cp .env.example .env
#   # Edit .env and add your actual credentials
#   ./start.sh


# ============================================
# PostgreSQL Configuration
# ============================================
# Database credentials for PostgreSQL container
# IMPORTANT: If you change these values, you must also update:
#   - pgadmin/servers.json (MaintenanceDB, Username)
#   - pgadmin/pgpassfile (format: host:port:database:username:password)
POSTGRES_DB=mcpdb
POSTGRES_USER=mcp_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5434

# Database schema name (used by MCP Server and Email Worker)
SCHEMA_NAME=test


# ============================================
# pgAdmin Configuration
# ============================================
# Web UI for PostgreSQL administration
# Access at: http://localhost:{PGADMIN_PORT}
# Login with PGADMIN_EMAIL and PGADMIN_PASSWORD
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_secure_pgadmin_password_here
PGADMIN_PORT=8090


# ============================================
# Docker Compose Configuration
# ============================================
# Project name for Docker containers and volumes
COMPOSE_PROJECT_NAME=docker-config


# ============================================
# Email Service Configuration (Email Worker)
# ============================================
# SMTP server for sending transactional emails
# Recommended: Use Gmail App Password or dedicated SMTP service

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Lab01 Bookings
SMTP_USE_TLS=true

# Email Worker polling configuration
EMAIL_WORKER_POLL_INTERVAL=10
EMAIL_WORKER_BATCH_SIZE=50
EMAIL_RETRY_MAX_ATTEMPTS=3
EMAIL_RETRY_BACKOFF_SECONDS=300

# Email reminders (send notifications before appointments)
REMINDER_24H_ENABLED=true
REMINDER_1H_ENABLED=true


# ============================================
# MCP Server Configuration
# ============================================
# Google API Key (REQUIRED - for embeddings and AI features)
# Get one at: https://console.cloud.google.com/
# Note: Keep this secret and rotate regularly
GOOGLE_API_KEY=your_google_api_key_here

# Embedding Model Configuration
# Used for semantic search and memory features
EMBEDDING_MODEL=gemini-embedding-001

# Processing Configuration
BATCH_SIZE=8
PGVECTOR_IVF_LISTS=100

# MCP Server Logging
LOG_LEVEL=INFO
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5


# ============================================
# Google Calendar Integration (Optional)
# ============================================
# Enable/disable Google Calendar booking integration
GOOGLE_CALENDAR_ENABLED=false

# Path to Google service account JSON credentials
# Store the actual credentials file in ../credentials/service-account.json
# Instructions: https://cloud.google.com/docs/authentication/getting-started
GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials/service-account.json

# Calendar ID and timezone for appointments
# Calendar ID is usually your Google email
GOOGLE_CALENDAR_ID=your_calendar_id@gmail.com
GOOGLE_CALENDAR_TIMEZONE=America/Costa_Rica


# ============================================
# Booking Configuration (Optional)
# ============================================
# Default appointment duration in minutes
BOOKING_DEFAULT_DURATION_MINUTES=60

# Time slot interval for availability (in minutes)
# e.g., 30 means slots at 00, 30, 60 minutes of each hour
BOOKING_SLOT_INTERVAL_MINUTES=30

# How many days in advance users can book
BOOKING_ADVANCE_BOOKING_DAYS=30

# Minimum advance notice to book (in minutes)
BOOKING_MIN_ADVANCE_MINUTES=60

# Maximum appointments allowed per day
BOOKING_MAX_DAILY_APPOINTMENTS=10


# ============================================
# Memory Configuration (Optional)
# ============================================
# Enable/disable conversation memory feature
MEMORY_ENABLED=true

# How long to keep memory records (in days)
MEMORY_TTL_DAYS=90

# Maximum conversation turns to store in memory
MEMORY_MAX_HISTORY_TURNS=10

# Extract semantic information from conversations
MEMORY_SEMANTIC_EXTRACTION_ENABLED=true

# Automatically cleanup old memory entries
MEMORY_AUTO_CLEANUP_ENABLED=true

# Minimum priority threshold for memory storage (1-10)
# Higher values = only important items stored
MEMORY_PRIORITY_THRESHOLD=5