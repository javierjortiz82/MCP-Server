# ============================================
# PostgreSQL Database Configuration
# ============================================
# Connection string for PostgreSQL database
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://your_user:your_password@localhost:5434/your_database

# Individual PostgreSQL parameters (for compatibility)
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# ============================================
# Database Schema Configuration
# ============================================
# Schema name for products and MCP tables
SCHEMA_NAME=test

# ============================================
# Google Gemini API Configuration
# ============================================
# Google API key for embedding generation
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Embedding model configuration
EMBEDDING_MODEL=gemini-embedding-001
OUTPUT_DIMENSIONALITY=1536

# ============================================
# Processing Configuration
# ============================================
# Batch size for API calls (recommended: 8)
# Lower values = more API calls but safer rate limiting
# Higher values = fewer API calls but risk rate limit errors
BATCH_SIZE=8

# Retry configuration for API calls
MAX_RETRIES=5
RETRY_MIN_WAIT=2
RETRY_MAX_WAIT=30

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s %(levelname)s %(message)s
