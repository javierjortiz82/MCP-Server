# ============================================
# PostgreSQL Database Configuration
# ============================================
# Connection string for PostgreSQL database
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://mcp_user:mcp_password@localhost:5434/mcpdb

# Database Schema Configuration
SCHEMA_NAME=test

# ============================================
# Google Gemini API Configuration
# ============================================
# Google API key for embedding generation (REQUIRED for populate.py)
# Used to generate embeddings for products during database seeding
# ¿Dónde obtenerla?
#   1. Ve a https://aistudio.google.com/app/apikey
#   2. Haz clic en "Create API Key"
#   3. Google generará una nueva clave API
#   4. Copia la clave y reemplaza 'your_google_api_key_here' aquí
# IMPORTANTE: Nunca compartas tu API key en repositorios públicos
GOOGLE_API_KEY=your_google_api_key_here

# Embedding model configuration
EMBEDDING_MODEL=gemini-embedding-001

# ============================================
# Processing Configuration
# ============================================
# Batch size for API calls (recommended: 8)
BATCH_SIZE=8

# Number of IVF lists for pgvector
PGVECTOR_IVF_LISTS=100

# ============================================
# Logging Configuration
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Maximum log file size in megabytes (default: 10)
LOG_MAX_SIZE_MB=10

# Number of backup log files to keep (default: 5)
LOG_BACKUP_COUNT=5
