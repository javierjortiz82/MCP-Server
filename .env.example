# ============================================================================
# Lab01-MCP Environment Configuration
# ============================================================================
# This is the MASTER .env.example file for the entire Lab01-MCP project.
# All variables are mapped to Pydantic v2 BaseSettings models.
#
# USAGE:
#   cp .env.example .env
#   # Edit .env with your actual values
#
# SECURITY:
#   - NEVER commit .env to Git (already in .gitignore)
#   - Change all CHANGE_ME_* placeholders
#   - Use strong passwords (min 16 characters)
#
# UPDATED: 2025-10-27 (Post cleanup - Pydantic v2 validation only)
# ============================================================================

# ============================================================================
# 1. GOOGLE GEMINI API CONFIGURATION (Required for all services)
# ============================================================================
GOOGLE_API_KEY=your-google-api-key-here

# Model Selection
GEMINI_MODEL=gemini-2.0-flash-exp    # For agent service
MODEL=gemini-2.5-flash                # For client_mcp
EMBEDDING_MODEL=gemini-embedding-001  # For mcp_server

# AI Generation Parameters
TEMPERATURE=0.3
TOP_K=40
TOP_P=0.9
MAX_OUTPUT_TOKENS=8192

# Gemini 2.5+ Thinking Mode
ENABLE_THINKING=true
THINKING_BUDGET=1024
INCLUDE_THOUGHTS=false

# Gemini API Rate Limiting
ENABLE_RATE_LIMITING=true
GEMINI_RPM_LIMIT=15
GEMINI_RPD_LIMIT=1500
MAX_CONCURRENT_REQUESTS=3

# ============================================================================
# 2. POSTGRESQL DATABASE CONFIGURATION
# ============================================================================
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://mcp_user:mcp_password@localhost:5434/mcpdb
SCHEMA_NAME=test

# PGVector Configuration (for mcp_server embeddings)
PGVECTOR_IVF_LISTS=100
BATCH_SIZE=8

# ============================================================================
# 3. MCP SERVER CONFIGURATION
# ============================================================================
MCP_HOST=localhost
MCP_PORT=8009

# ============================================================================
# 4. AGENT SERVICE CONFIGURATION
# ============================================================================
AGENT_PORT=8000
AGENT_HOST=0.0.0.0

# ============================================================================
# 5. APPLICATION SETTINGS (Shared)
# ============================================================================
DEBUG_MODE=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Performance & Features
ENABLE_CACHE=true
CACHE_TTL_SECONDS=300.0
ENABLE_METRICS=true
ENABLE_VALIDATION=true
ENABLE_FALLBACK=true
FALLBACK_MAX_DEPTH=2

# ============================================================================
# 6. LOGGING CONFIGURATION (All Services)
# ============================================================================
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=./logs
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5

# ============================================================================
# 7. METRICS & OBSERVABILITY
# ============================================================================
METRICS_EXPORT_PATH=data/execution_metrics.json

# ============================================================================
# 8. GOOGLE CALENDAR API (Booking System)
# ============================================================================
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials/service-account.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=America/New_York

# ============================================================================
# 9. BOOKING CONFIGURATION
# ============================================================================
BOOKING_DEFAULT_DURATION_MINUTES=60
BOOKING_SLOT_INTERVAL_MINUTES=30
BOOKING_ADVANCE_BOOKING_DAYS=30
BOOKING_MIN_ADVANCE_MINUTES=60
BOOKING_MAX_DAILY_APPOINTMENTS=10

# Booking Confidence Thresholds
BOOKING_CHOICE_CONFIDENCE_THRESHOLD=0.75
BOOKING_PARTIAL_MATCH_CONFIDENCE=0.95
BOOKING_MIN_KEYWORD_LENGTH=3
BOOKING_FUZZY_MATCH_THRESHOLD=0.75
BOOKING_CONFIRMATION_THRESHOLD=0.75
BOOKING_CLARIFICATION_THRESHOLD=0.6
BOOKING_EMAIL_QUEUE_PRIORITY=5

# ============================================================================
# 10. BOOKING AGENT CONFIGURATION
# ============================================================================
BOOKING_MAX_FUNCTION_CALL_ITERATIONS=10
BOOKING_MAX_PROMPT_SIZE_CHARS=30000
BOOKING_MAX_CONTENT_SIZE_CHARS=100000
BOOKING_RESPONSE_TIMEOUT_SECONDS=30
BOOKING_MAX_OUTPUT_TOKENS=2048
BOOKING_TEMPERATURE=0.7
BOOKING_RETRY_MAX_ATTEMPTS=3
BOOKING_RETRY_BACKOFF_SECONDS=1.0

# Token Estimation
TOKEN_ESTIMATE_RATIO=0.25

# ============================================================================
# 11. CLIENT ADVANCED CONFIGURATION
# ============================================================================
# Tool Execution
MAX_FUNCTION_CALLS=5
TOOL_TIMEOUT=30

# Retry Strategy
ENABLE_RETRY=true
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=100.0
RETRY_MAX_DELAY_MS=5000.0
RETRY_EXPONENTIAL_BASE=2.0
RETRY_JITTER=true

# Context Caching (Gemini 1.5+)
ENABLE_CONTEXT_CACHING=true
CACHE_TTL_MINUTES=60

# Pagination
PAGINATION_PAGE_SIZE=4
PAGINATION_KEYWORDS_ES=más,siguiente,muéstrame,opciones
PAGINATION_KEYWORDS_EN=more,next,show,additional,options
PAGINATION_PERSISTENCE_ENABLED=false
PAGINATION_TTL_HOURS=24

# Sanitization
SANITIZE_INPUTS=true

# Error Pattern Detection
CACHE_ERROR_PATTERNS=403,PERMISSION_DENIED,CachedContent
RATE_LIMIT_ERROR_PATTERNS=429,quota,rate limit

# ============================================================================
# 12. MULTI-AGENT SYSTEM
# ============================================================================
ENABLE_AGENT_ROUTING=true
ROUTER_TEMPERATURE=0.0

# Sales Agent Configuration
FUNCTION_CALL_MAX_ITERATIONS=10
FALLBACK_ERROR_MESSAGE_ES=No pude generar una respuesta final. Las herramientas se ejecutaron pero no pude procesar el resultado.
FALLBACK_ERROR_MESSAGE_EN=I couldn't generate a final response. Tools were executed but I couldn't process the result.

# ============================================================================
# 13. SESSION LIFECYCLE & MEMORY (GDPR Compliance)
# ============================================================================
SESSION_SOFT_ARCHIVE_DAYS=90
SESSION_HARD_DELETE_DAYS=365
SESSION_PRESERVE_WITH_EMAIL_DAYS=180
SESSION_ANONYMOUS_DELETE_DAYS=30

# Memory Configuration
MEMORY_ENABLED=true
MEMORY_TTL_DAYS=90
MEMORY_MAX_HISTORY_TURNS=10
MEMORY_SEMANTIC_EXTRACTION_ENABLED=true
MEMORY_AUTO_CLEANUP_ENABLED=true
MEMORY_PRIORITY_THRESHOLD=5

# Memory Priority Thresholds
MEMORY_PRIORITY_HIGH_THRESHOLD=7
MEMORY_PRIORITY_MEDIUM_MIN=5
MEMORY_PRIORITY_MEDIUM_MAX=7
MEMORY_HIGH_PRIORITY_LIMIT=3
MEMORY_MEDIUM_PRIORITY_LIMIT=2
MEMORY_USER_BLOCKS_LIMIT=5

# ============================================================================
# 14. EMAIL SERVICE CONFIGURATION (Booking Notifications)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=noreply@lab01.com
SMTP_FROM_NAME=Lab01 Bookings
SMTP_USE_TLS=true
SMTP_TIMEOUT=30

# Email Worker Configuration
EMAIL_WORKER_POLL_INTERVAL=10
EMAIL_WORKER_BATCH_SIZE=50
EMAIL_RETRY_MAX_ATTEMPTS=3
EMAIL_RETRY_BACKOFF_SECONDS=300

# Email Reminders
REMINDER_24H_ENABLED=true
REMINDER_1H_ENABLED=true
REMINDER_24H_SUBJECT=Recordatorio: Cita mañana
REMINDER_1H_SUBJECT=Recordatorio: Cita en 1 hora

# Email Service Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=./email_service/logs
TEMPLATE_DIR=./email_service/templates

# ============================================================================
# CONFIGURATION NOTES
# ============================================================================
#
# SERVICE-SPECIFIC .env FILES:
# - mcp_server/.env      (for standalone mcp_server development)
# - client_mcp/.env      (for standalone client_mcp development)
# - agent/.env           (for standalone agent development)
#
# THIS FILE (root .env):
# - Used by Docker Compose for all services
# - All services reference these variables
# - Individual services can override via their own .env
#
# PYDANTIC V2 MIGRATION:
# - All variables are mapped to Pydantic BaseSettings models
# - No unmapped/unused variables (cleanup 2025-10-27)
# - Type validation and conversion automatic
#
# SECURITY REMINDERS:
# - Change all CHANGE_ME_* placeholders
# - Use strong passwords (min 16 characters, mixed case, numbers, symbols)
# - Regenerate SECRET_KEY and JWT_SECRET for production
# - Get Google API key from: https://aistudio.google.com/app/apikey
#
# ============================================================================
