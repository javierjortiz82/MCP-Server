# ============================================================================
# Lab01-MCP Environment Configuration (Complete Reference)
# ============================================================================
# This is the MASTER .env.example file for the entire Lab01-MCP project.
# It consolidates all environment variables from:
#   - Docker Compose (root)
#   - mcp_server/
#   - client_mcp/
#   - agent/
#
# USAGE:
#   1. Copy this file to .env:
#      cp .env.example .env
#
#   2. Update variables with your actual values
#
#   3. NEVER commit .env to Git (already in .gitignore)
#
# STRUCTURE:
#   Variables are organized by service/component for clarity.
#   Some variables are shared across multiple services.
#
# UPDATED: 2025-10-09 (Post Pydantic v2 Migration)
# ============================================================================

# ============================================================================
# 1. GOOGLE GEMINI API CONFIGURATION (Required for all services)
# ============================================================================
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Model Selection
GEMINI_MODEL=gemini-2.0-flash-exp  # For agent service
MODEL=gemini-2.5-flash             # For client_mcp
EMBEDDING_MODEL=gemini-embedding-001  # For mcp_server

# AI Generation Parameters
TEMPERATURE=0.3
TOP_K=40
TOP_P=0.9
MAX_OUTPUT_TOKENS=8192

# Gemini 2.5+ Thinking Mode
ENABLE_THINKING=true
THINKING_BUDGET=1024  # -1=auto, 0=off, >0=fixed tokens
INCLUDE_THOUGHTS=false  # true for debugging, false for production

# Gemini API Rate Limiting
ENABLE_RATE_LIMITING=true
GEMINI_RPM_LIMIT=15  # Requests per minute (Free tier: 15, Pay-as-you-go: varies)
GEMINI_RPD_LIMIT=1500  # Requests per day (Free tier: 1500, Pay-as-you-go: higher)
MAX_CONCURRENT_REQUESTS=3  # Max simultaneous API calls

# Future AI Providers (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ============================================================================
# 3. MCP SERVER CONFIGURATION
# ============================================================================
MCP_HOST=localhost
MCP_PORT=3000
MCP_TIMEOUT=30
MCP_MAX_RETRIES=3

# ============================================================================
# 4. AGENT SERVICE CONFIGURATION
# ============================================================================
AGENT_PORT=8000
AGENT_HOST=0.0.0.0  # Use 0.0.0.0 for Docker, localhost for local dev

# ============================================================================
# 2. POSTGRESQL DATABASE CONFIGURATION
# ============================================================================
# All services (mcp_server, email_service, client_mcp) use the same PostgreSQL instance

# Docker Compose Variables (for PostgreSQL container initialization)
POSTGRES_USER=mcp_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=mcp_db
POSTGRES_PORT=5434  # External port (internal remains 5432)

# PostgreSQL Connection URL (RECOMMENDED - Used by all services)
# Format: postgresql://user:password@host:port/database
# This is the PRIMARY configuration variable. All services use this URL.
DATABASE_URL=postgresql://mcp_user:CHANGE_ME_STRONG_PASSWORD@localhost:5434/mcp_db

# Database Schema Configuration
SCHEMA_NAME=test  # PostgreSQL schema name (shared across all modules)

# PGVector Configuration (for mcp_server embeddings)
VECTOR_DIMENSIONS=1536
ENABLE_VECTOR_SEARCH=true
PGVECTOR_IVF_LISTS=100  # More lists = faster search, more memory

# Connection Pool Configuration (for specific services if needed)
DB_POOL_SIZE=10  # mcp_server pool size
DB_MAX_OVERFLOW=20  # mcp_server max overflow

# Data Configuration
PRODUCTS_JSON_PATH=./data/products.json
BATCH_SIZE=8

# ============================================================================
# 5. APPLICATION SETTINGS (Shared)
# ============================================================================

# Environment
ENVIRONMENT=development  # development, staging, production
DEBUG_MODE=false
DEBUG=false  # Alternative name used by some services
PYTHON_VERSION=3.11

# Security
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET_KEY
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_JWT_SECRET
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Performance & Features
ENABLE_CACHE=true
USE_CACHE=true  # Alternative name
CACHE_TTL=3600  # seconds
CACHE_TTL_SECONDS=300.0  # For client_mcp (5 minutes)

ENABLE_METRICS=true
ENABLE_VALIDATION=true
ENABLE_FALLBACK=true
FALLBACK_MAX_DEPTH=2

# Rate Limiting (Application Level)
RATE_LIMIT_ENABLED=true
USE_RATE_LIMITING=true  # Alternative name
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Health Checks
ENABLE_HEALTH_CHECKS=true

# ============================================================================
# 6. LOGGING CONFIGURATION (All Services)
# ============================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# File Logging
LOG_TO_FILE=true
LOG_FORMAT=json  # json or plain
LOG_DIR=./logs
LOG_DIR_PATH=./logs  # Alternative name

# Log Rotation
LOG_MAX_SIZE=10485760  # 10MB in bytes
LOG_MAX_SIZE_MB=10     # 10MB (mcp_server format)
LOG_BACKUP_COUNT=5

# ============================================================================
# 7. METRICS & OBSERVABILITY
# ============================================================================
ENABLE_METRICS=true
METRICS_EXPORT_PATH=data/execution_metrics.json

# Prometheus (Optional)
PROMETHEUS_PORT=9090

# Tracing (Optional)
ENABLE_TRACING=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ============================================================================
# 8. DOCKER COMPOSE CONFIGURATION
# ============================================================================
DOCKER_NETWORK=lab01_network
POSTGRES_CONTAINER_NAME=lab01_postgres
PGADMIN_CONTAINER_NAME=lab01_pgadmin

# PGAdmin (Development Tool)
PGADMIN_EMAIL=admin@lab01.local
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
PGADMIN_PORT=5050

# Redis (Optional - profile: cache)
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379

# ============================================================================
# 9. CLIENT_MCP ADVANCED CONFIGURATION
# ============================================================================

# Tool Execution
MAX_FUNCTION_CALLS=5
TOOL_TIMEOUT=30

# Retry Strategy
ENABLE_RETRY=true
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=100.0
RETRY_MAX_DELAY_MS=5000.0
RETRY_EXPONENTIAL_BASE=2.0
RETRY_JITTER=true

# Thinking Mode (Gemini 2.5+ only)
ENABLE_THINKING=true
THINKING_BUDGET=1024  # -1=auto, 0=off, >0=fixed tokens
INCLUDE_THOUGHTS=false  # true for debugging, false for production

# Context Caching (Gemini 1.5+)
ENABLE_CONTEXT_CACHING=true
CACHE_TTL_MINUTES=60  # 1 hour (development), 240-480 (production)

# Pagination
PAGINATION_PAGE_SIZE=4  # Products per page
PAGINATION_PERSISTENCE_ENABLED=false
PAGINATION_DB_HOST=localhost
PAGINATION_DB_PORT=5434
PAGINATION_DB_NAME=mcpdb
PAGINATION_DB_USER=mcp_user
PAGINATION_DB_PASSWORD=mcp_password
PAGINATION_TTL_HOURS=24

# Sanitization
SANITIZE_INPUTS=true

# ============================================================================
# 10. FEATURE FLAGS
# ============================================================================
ENABLE_ADVANCED_SEARCH=true
ENABLE_SEMANTIC_SEARCH=true
ENABLE_MULTI_LANGUAGE=false
ENABLE_VOICE_INTERFACE=false

# Multi-Agent System (NEW)
ENABLE_AGENT_ROUTING=true  # Enable multi-agent routing (sales, booking, general)
ROUTER_TEMPERATURE=0.0      # Temperature for intent classification (deterministic)

# ============================================================================
# 10. SALES AGENT CONFIGURATION
# ============================================================================
# DOCUMENTATION: agent/src/multi_agent/sales_agent.py
# SETTINGS: client_mcp/config/settings.py
#
# SalesAgent Settings:
# - Function calling loop configuration
# - Tool and keyword management
# - Error handling and fallback messages
# - Language-specific pagination keywords (i18n support)
#
# Configuration-driven features:
# - Tunable function calling iterations
# - Configurable search tool names
# - Internationalization support (Spanish + English)
# - Error pattern detection (cache, rate limits)

# SalesAgent Function Calling Configuration
FUNCTION_CALL_MAX_ITERATIONS=10               # Max iterations in function calling loop (1-50, default: 10)

# SalesAgent Pagination Keywords (Internationalization)
PAGINATION_KEYWORDS_ES=más,siguiente,muéstrame,opciones  # Spanish keywords for "show more" requests
PAGINATION_KEYWORDS_EN=more,next,show,additional,options  # English keywords for "show more" requests

# SalesAgent Error Handling & Fallback Messages
FALLBACK_ERROR_MESSAGE_ES=No pude generar una respuesta final. Las herramientas se ejecutaron pero no pude procesar el resultado.
FALLBACK_ERROR_MESSAGE_EN=I couldn't generate a final response. Tools were executed but I couldn't process the result.

# SalesAgent Error Pattern Detection
CACHE_ERROR_PATTERNS=403,PERMISSION_DENIED,CachedContent    # Patterns indicating cache expiry (comma-separated)
RATE_LIMIT_ERROR_PATTERNS=429,quota,rate limit               # Patterns indicating rate limiting (comma-separated)

# ============================================================================
# 11. SESSION LIFECYCLE & DATA RETENTION (GDPR Compliance)
# ============================================================================
# DOCUMENTATION: docs/SESSION_LIFECYCLE_POLICY.md
# CLI TOOL: scripts/session_lifecycle.sh
# CRON JOB: scripts/cleanup_expired_memories.py
#
# Session lifecycle stages:
# 1. Active (0-90 days): Full context, all features available
# 2. Archived (90-365 days): Soft delete, excluded from queries
# 3. Deleted (365+ days): Hard delete, GDPR compliance
#
# Memory retention:
# - Session memory blocks: 90 days TTL (expires after inactivity)
# - User memory blocks: 180 days TTL (cross-session continuity)
# - Anonymous sessions: 30 days then deleted (low business value)
#
# Compliance: GDPR Article 17 (Right to be Forgotten), CCPA Section 1798.105

# Session Lifecycle Configuration
SESSION_SOFT_ARCHIVE_DAYS=90          # Archive sessions after 90 days inactivity
SESSION_HARD_DELETE_DAYS=365          # Delete archived sessions after 365 days
SESSION_PRESERVE_WITH_EMAIL_DAYS=180  # Keep email sessions longer (CRM value)
SESSION_ANONYMOUS_DELETE_DAYS=30      # Delete anonymous sessions faster

# Memory Configuration
MEMORY_TTL_DAYS=90                    # Session memory block TTL
MEMORY_AUTO_CLEANUP_ENABLED=true      # Enable automatic cleanup job

# Commands:
# - View stats:          ./scripts/session_lifecycle.sh stats
# - Run cleanup:         ./scripts/session_lifecycle.sh cleanup
# - Archive sessions:    ./scripts/session_lifecycle.sh archive
# - GDPR export:         ./scripts/session_lifecycle.sh gdpr-export user@example.com
# - GDPR delete:         ./scripts/session_lifecycle.sh gdpr-delete user@example.com

# ============================================================================
# 12. GOOGLE CALENDAR API (Booking System)
# ============================================================================
# DOCUMENTATION: docs/GOOGLE_CALENDAR_SETUP.md
# TEST SCRIPT: test_calendar_integration.py
#
# Setup Instructions:
# 1. Create project: https://console.cloud.google.com/
# 2. Enable Google Calendar API
# 3. Create Service Account
# 4. Download JSON credentials (service-account.json)
# 5. Share calendar with service account email (grant "Make changes to events")
# 6. Place JSON file in credentials/ directory
# 7. Set GOOGLE_CALENDAR_ENABLED=true
# 8. Run test: python3 test_calendar_integration.py
#
# What gets synced:
# - Booking creation → Calendar event created
# - Booking reschedule → Calendar event updated
# - Booking cancellation → Calendar event deleted
# - Reminders: 30 minutes and 10 minutes before appointment
# - Customer email added as attendee (receives notification)
#
# Authentication: Service Account (server-to-server, no OAuth flow)
# API Quota: 1,000,000 queries/day (Google Calendar API free tier)

# Google Calendar Integration (REQUIRED)
GOOGLE_CALENDAR_ENABLED=false  # Set to true to enable integration
GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials/service-account.json  # Path to service account JSON
GOOGLE_CALENDAR_ID=primary  # "primary" or specific calendar ID (e.g., bookings@example.com)
GOOGLE_CALENDAR_TIMEZONE=America/New_York  # IANA timezone (e.g., Europe/Madrid, Asia/Tokyo)

# Common Timezones:
# - US East:        America/New_York
# - US West:        America/Los_Angeles
# - US Central:     America/Chicago
# - Spain:          Europe/Madrid
# - UK:             Europe/London
# - Japan:          Asia/Tokyo
# - Australia:      Australia/Sydney

# ============================================================================
# HOW TO GET service-account.json (Step-by-Step)
# ============================================================================
#
# Step 1: Create Google Cloud Project
# - URL: https://console.cloud.google.com/
# - Click "Select a project" → "New Project"
# - Name: "Lab01-MCP-Calendar" (or your preferred name)
# - Click "Create"
#
# Step 2: Enable Google Calendar API
# - URL: https://console.cloud.google.com/apis/library/calendar-json.googleapis.com
# - Click "Enable"
# - Wait for activation (10-15 seconds)
#
# Step 3: Create Service Account
# - URL: https://console.cloud.google.com/iam-admin/serviceaccounts
# - Click "Create Service Account"
# - Service account name: lab01-mcp-calendar-bot
# - Description: "Service account for Lab01-MCP booking calendar integration"
# - Click "Create and Continue" → "Continue" → "Done"
# - COPY the service account email (example below):
#   lab01-mcp-calendar-bot@lab01-mcp-calendar.iam.gserviceaccount.com
#
# Step 4: Download JSON Key File
# - In "Service Accounts" page, click on your service account
# - Go to "Keys" tab
# - Click "Add Key" → "Create new key"
# - Select "JSON" format
# - Click "Create"
# - File downloads automatically (e.g., lab01-mcp-calendar-abc123.json)
#
# Step 5: Share Calendar with Service Account
# - Open Google Calendar: https://calendar.google.com/
# - Click ⋮ (three dots) next to calendar → "Settings and sharing"
# - Scroll to "Share with specific people"
# - Click "Add people"
# - Enter service account email from Step 3
# - Set permission: "Make changes to events"
# - Click "Send"
#
# Step 6: Install JSON File in Lab01-MCP
# - Create credentials directory:
#   mkdir -p /home/javort/Lab01-MCP/credentials
#
# - Move downloaded file:
#   mv ~/Downloads/lab01-mcp-calendar-*.json \
#      /home/javort/Lab01-MCP/credentials/service-account.json
#
# - Set secure permissions:
#   chmod 600 /home/javort/Lab01-MCP/credentials/service-account.json
#
# Step 7: Update .env with Credentials Path
# - The variables below should be configured (see GOOGLE_CALENDAR_ENABLED section)
# - Ensure GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials/service-account.json
#
# Step 8: Test Integration
# - Run the automated test:
#   cd /home/javort/Lab01-MCP
#   python3 test_calendar_integration.py
#
# Expected output: "✅ ALL TESTS PASSED - Google Calendar integration is working!"
#
# ⚠️ SECURITY WARNING:
# - NEVER commit credentials/service-account.json to Git
# - Add to .gitignore: echo "credentials/" >> .gitignore
# - Keep file permissions restricted: chmod 600
# - Rotate credentials every 90 days from Google Cloud Console
# - Monitor API usage at: https://console.cloud.google.com/apis/dashboard
#
# 📚 FULL DOCUMENTATION:
# See docs/GOOGLE_CALENDAR_SETUP.md for complete setup guide with:
# - Detailed troubleshooting section
# - Security best practices
# - Multiple calendar support
# - API quotas and limitations
# - Quarterly maintenance checklist
#
# API Details:
# - API Quotas: 1,000,000 queries/day (free tier)
# - Support: https://developers.google.com/calendar/api
# - Service Accounts: https://cloud.google.com/iam/docs/service-accounts
#
# ============================================================================

# Booking Configuration
BOOKING_DEFAULT_DURATION_MINUTES=60  # Default appointment duration
BOOKING_SLOT_INTERVAL_MINUTES=30     # Available time slot intervals
BOOKING_ADVANCE_BOOKING_DAYS=30      # Max days in advance for booking
BOOKING_MIN_ADVANCE_MINUTES=60       # Minimum minutes in advance to book (default: 60 = 1 hour)
BOOKING_MAX_DAILY_APPOINTMENTS=10    # Max appointments per day

# Booking Input Parser Configuration (Confidence Thresholds)
# These thresholds control the fuzzy matching for user intent (reschedule/cancel/confirm/deny)
BOOKING_CHOICE_CONFIDENCE_THRESHOLD=0.6     # Min confidence for reschedule/cancel classification (0.0-1.0)
BOOKING_PARTIAL_MATCH_CONFIDENCE=0.95       # Confidence score for partial word matches (0.0-1.0)
BOOKING_MIN_KEYWORD_LENGTH=3                # Min string length for substring matching
BOOKING_FUZZY_MATCH_THRESHOLD=0.75          # SequenceMatcher threshold for fuzzy matching (0.0-1.0)
BOOKING_CONFIRMATION_THRESHOLD=0.6          # Min confidence for yes/no confirmation (0.0-1.0)
BOOKING_CLARIFICATION_THRESHOLD=0.6         # Below this, agent asks for clarification (0.0-1.0)
BOOKING_EMAIL_QUEUE_PRIORITY=5              # Email queue priority for notifications (1=lowest, 10=highest)

# Notifications
BOOKING_NOTIFICATION_EMAIL_ENABLED=false  # Send email notifications (requires SMTP config)
BOOKING_SEND_REMINDERS=true               # Add calendar reminders to events
BOOKING_REMINDER_MINUTES_BEFORE=30,10     # Reminder times (comma-separated)

# ============================================================================
# 13. EMAIL SERVICE CONFIGURATION (Booking Notifications)
# ============================================================================
# DOCUMENTATION: email_service/README.md
# DEPLOYMENT: Docker container (email-worker service)
# INITIALIZATION: python3 SQL/src/init_email_queue.py
#
# Email Notification System:
# - Queue-based delivery (PostgreSQL + Worker)
# - SMTP integration (Gmail, SendGrid, AWS SES compatible)
# - HTML email templates (Jinja2)
# - Automatic retries with exponential backoff
# - Status tracking (pending → processing → sent/failed)
#
# Email Types:
# - booking_created: Confirmation when booking is created
# - booking_cancelled: Notice when booking is cancelled
# - booking_rescheduled: Updated details when rescheduled
# - reminder_24h: Reminder sent 24 hours before appointment
# - reminder_1h: Urgent reminder 1 hour before appointment
#
# Setup Instructions:
# 1. Enable Gmail SMTP:
#    - Go to: https://myaccount.google.com/apppasswords
#    - Generate App Password (NOT your Gmail password)
#    - Set SMTP_USER=your.email@gmail.com
#    - Set SMTP_PASSWORD=your-16-char-app-password
# 2. Alternative: Use SendGrid, AWS SES, or other SMTP provider
# 3. Initialize database: python3 SQL/src/init_email_queue.py
# 4. Start worker: docker-compose up email-worker
# 5. Test: Check email_service/logs/ for delivery status
#
# Gmail Limits: 500 emails/day (free), 2000/day (Google Workspace)
# SendGrid Free Tier: 100 emails/day
# AWS SES: $0.10 per 1000 emails (after 62K free emails/month)

# SMTP Server Configuration (REQUIRED for email notifications)
SMTP_HOST=smtp.gmail.com                # Gmail: smtp.gmail.com, SendGrid: smtp.sendgrid.net
SMTP_PORT=587                           # 587 for TLS, 465 for SSL
SMTP_USER=your.email@gmail.com          # SMTP username (Gmail: your.email@gmail.com)
SMTP_PASSWORD=your-app-password-here    # SMTP password (Gmail: 16-char app password)
SMTP_FROM_EMAIL=noreply@lab01.com       # "From" email address
SMTP_FROM_NAME=Lab01 Bookings           # "From" display name
SMTP_USE_TLS=true                       # Use TLS encryption (recommended)
SMTP_TIMEOUT=30                         # Connection timeout (seconds)

# Email Worker Configuration
EMAIL_WORKER_POLL_INTERVAL=10           # Seconds between queue polls (default: 10)
EMAIL_WORKER_BATCH_SIZE=50              # Max emails per batch (default: 50)
EMAIL_RETRY_MAX_ATTEMPTS=3              # Max retry attempts (default: 3)
EMAIL_RETRY_BACKOFF_SECONDS=300         # Initial backoff delay in seconds (default: 300 = 5 min)

# Email Reminders
REMINDER_24H_ENABLED=true               # Send 24-hour reminder emails
REMINDER_1H_ENABLED=true                # Send 1-hour reminder emails
REMINDER_24H_SUBJECT=Recordatorio: Cita mañana
REMINDER_1H_SUBJECT=Recordatorio: Cita en 1 hora

# Email Service Logging
EMAIL_LOG_LEVEL=INFO                    # DEBUG, INFO, WARNING, ERROR, CRITICAL
EMAIL_LOG_TO_FILE=true                  # Write logs to file
EMAIL_LOG_DIR=./email_service/logs      # Log directory path

# Email Templates
TEMPLATE_DIR=./email_service/templates  # Path to Jinja2 email templates

# ============================================================================
# 14. AGENT CONFIGURATION (Booking Agent & Router)
# ============================================================================
# DOCUMENTATION: agent/README.md
# SETTINGS: agent/src/gemini_agent/config/booking_agent_settings.py
#
# Booking Agent Settings:
# - Function calling loop configuration
# - Prompt size constraints and validation
# - Token estimation parameters
# - Response generation timeouts and retries
#
# Agent Router Settings:
# - Memory context prioritization
# - Session vs. user-level memory balance
# - Intent classification confidence thresholds

# Booking Agent Function Calling Configuration
BOOKING_MAX_FUNCTION_CALL_ITERATIONS=10      # Max iterations in booking agent loop (1-50, default: 10)
BOOKING_RESPONSE_TIMEOUT_SECONDS=30          # Timeout for Gemini API response in seconds
BOOKING_MAX_OUTPUT_TOKENS=2048               # Maximum output tokens for Gemini API response

# Booking Agent Prompt Size Constraints (Warning Thresholds)
BOOKING_MAX_PROMPT_SIZE_CHARS=30000          # Max system prompt size in characters (warning if exceeded)
BOOKING_MAX_CONTENT_SIZE_CHARS=100000        # Max total content size in characters (warning if exceeded)

# Token Estimation (for cost/performance tracking)
TOKEN_ESTIMATE_RATIO=0.25                    # Ratio for estimating tokens (1 token ≈ 4 chars = ratio 0.25)

# Booking Agent Response Generation
BOOKING_TEMPERATURE=0.7                      # Temperature for response generation (0.0=deterministic, 2.0=creative)
BOOKING_RETRY_MAX_ATTEMPTS=3                 # Maximum retry attempts for failed Gemini API calls
BOOKING_RETRY_BACKOFF_SECONDS=1.0            # Initial backoff time in seconds for retry logic (exponential)

# ============================================================================
# 15. AGENT MEMORY CONFIGURATION (Priority Thresholds & Display Limits)
# ============================================================================
# DOCUMENTATION: agent/README.md, mcp_server/utils/memory_manager.py
#
# Memory Priority System (0-10 scale):
# - High Priority (7-10): Critical customer info, booking preferences, urgent issues
# - Medium Priority (5-7): General customer interests, purchase history
# - Low Priority (0-5): One-time queries, transient context
#
# Context Inclusion Strategy:
# - Session memory: Short-term context from current conversation
# - User memory: Long-term cross-session context (CRM continuity)
# - Both combined for richer classification and personalization

# Memory Priority Thresholds
MEMORY_PRIORITY_HIGH_THRESHOLD=7             # Priority threshold for high-priority blocks (0-10 scale)
MEMORY_PRIORITY_MEDIUM_MIN=5                 # Minimum priority for medium-priority blocks
MEMORY_PRIORITY_MEDIUM_MAX=7                 # Maximum priority for medium-priority blocks

# Memory Block Limits in Agent Context
MEMORY_HIGH_PRIORITY_LIMIT=3                 # Max high-priority blocks in agent context (session)
MEMORY_MEDIUM_PRIORITY_LIMIT=2               # Max medium-priority blocks in agent context (session)
MEMORY_USER_BLOCKS_LIMIT=5                   # Max user-level blocks in agent context (cross-session)

# Memory System Configuration
MEMORY_ENABLED=true                          # Enable persistent memory system for multi-agent context
MEMORY_TTL_DAYS=90                           # Default TTL for memory blocks in days
MEMORY_MAX_HISTORY_TURNS=10                  # Max conversation turns to keep in short-term memory (1-50)
MEMORY_SEMANTIC_EXTRACTION_ENABLED=true      # Enable LLM-based semantic memory extraction
MEMORY_AUTO_CLEANUP_ENABLED=true             # Enable automatic cleanup of expired memory blocks
MEMORY_PRIORITY_THRESHOLD=5                  # Minimum priority score (0-10) to persist memory block

# ============================================================================
# 16. EXTERNAL SERVICES (Optional)
# ============================================================================

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# Elasticsearch (for advanced search)
ELASTICSEARCH_URL=http://localhost:9200

# S3 (for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Future AI Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ============================================================================
# 17. DEVELOPMENT & TESTING
# ============================================================================

# Testing
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5434/test_db
PYTEST_COVERAGE_THRESHOLD=80

# Hot Reload
RELOAD_ON_CHANGE=true
WATCH_DIRECTORIES=./src,./agent

# Mock Services
USE_MOCK_MCP=false
USE_MOCK_DATABASE=false

# ============================================================================
# CONFIGURATION NOTES
# ============================================================================
#
# SERVICE-SPECIFIC .env FILES:
# - mcp_server/.env      - For MCP server standalone development
# - client_mcp/.env      - For client standalone development
# - agent/.env           - For agent standalone development
#
# THIS FILE (.env in root):
# - Used by Docker Compose to configure all services
# - Provides defaults for all environment variables
# - Should contain ALL variables from all services
#
# PRIORITY:
# 1. Docker Compose uses variables from THIS file (root .env)
# 2. Individual services can override with their own .env files
# 3. Environment variables in shell override both
#
# SECURITY REMINDERS:
# - NEVER commit .env files to Git
# - Change all CHANGE_ME_* placeholders
# - Use strong passwords (min 16 characters, mixed case, numbers, symbols)
# - Regenerate SECRET_KEY and JWT_SECRET for production
# - Get Google API key from: https://aistudio.google.com/app/apikey
#
# DOCUMENTATION:
# - See docs/MIGRATION_PYDANTIC_V2.md for variable naming conventions
# - See DockerConfig/README.md for Docker setup
# - See individual .env.example files for service-specific details
#
# VARIABLE NAMING:
# - Post Pydantic v2 migration: UPPER_CASE for constants
# - Some legacy snake_case names kept for compatibility
# - Both formats supported in most services
#
# ============================================================================
# END OF CONFIGURATION
# ============================================================================