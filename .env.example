# ============================================================================
# Lab01-MCP Environment Configuration (Complete Reference)
# ============================================================================
# This is the MASTER .env.example file for the entire Lab01-MCP project.
# It consolidates all environment variables from:
#   - Docker Compose (root)
#   - mcp_server/
#   - client_mcp/
#   - agent/
#
# USAGE:
#   1. Copy this file to .env:
#      cp .env.example .env
#
#   2. Update variables with your actual values
#
#   3. NEVER commit .env to Git (already in .gitignore)
#
# STRUCTURE:
#   Variables are organized by service/component for clarity.
#   Some variables are shared across multiple services.
#
# UPDATED: 2025-10-09 (Post Pydantic v2 Migration)
# ============================================================================

# ============================================================================
# 1. GOOGLE GEMINI API CONFIGURATION (Required for all services)
# ============================================================================
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Model Selection
GEMINI_MODEL=gemini-2.0-flash-exp  # For agent service
MODEL=gemini-2.5-flash             # For client_mcp
EMBEDDING_MODEL=gemini-embedding-001  # For mcp_server

# AI Generation Parameters
TEMPERATURE=0.3
TOP_K=40
TOP_P=0.9
MAX_OUTPUT_TOKENS=8192

# Gemini 2.5+ Thinking Mode
ENABLE_THINKING=true
THINKING_BUDGET=1024  # -1=auto, 0=off, >0=fixed tokens
INCLUDE_THOUGHTS=false  # true for debugging, false for production

# Gemini API Rate Limiting
ENABLE_RATE_LIMITING=true
GEMINI_RPM_LIMIT=15  # Requests per minute (Free tier: 15, Pay-as-you-go: varies)
GEMINI_RPD_LIMIT=1500  # Requests per day (Free tier: 1500, Pay-as-you-go: higher)
MAX_CONCURRENT_REQUESTS=3  # Max simultaneous API calls

# Future AI Providers (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ============================================================================
# 3. MCP SERVER CONFIGURATION
# ============================================================================
MCP_HOST=localhost
MCP_PORT=3000
MCP_TIMEOUT=30
MCP_MAX_RETRIES=3

# ============================================================================
# 4. AGENT SERVICE CONFIGURATION
# ============================================================================
AGENT_PORT=8000
AGENT_HOST=0.0.0.0  # Use 0.0.0.0 for Docker, localhost for local dev

# ============================================================================
# 2. POSTGRESQL DATABASE CONFIGURATION
# ============================================================================
# These variables are used by Docker Compose to create the PostgreSQL container
# and by mcp_server for database connections.

# Docker Compose Variables (Primary)
POSTGRES_USER=mcp_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=mcp_db
POSTGRES_PORT=5434  # External port (internal remains 5432)

# Alternative Format (used by some services)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=mcp_db
DB_USER=mcp_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# mcp_server uses this consolidated URL format:
DATABASE_URL=postgresql://mcp_user:CHANGE_ME_STRONG_PASSWORD@localhost:5434/mcp_db

# Schema Configuration
SCHEMA_NAME=test  # PostgreSQL schema for products table

# PGVector Configuration
VECTOR_DIMENSIONS=1536
ENABLE_VECTOR_SEARCH=true
PGVECTOR_IVF_LISTS=100  # More lists = faster search, more memory

# Connection Pool (for production)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Data Configuration
PRODUCTS_JSON_PATH=./data/products.json
BATCH_SIZE=8

# ============================================================================
# 5. APPLICATION SETTINGS (Shared)
# ============================================================================

# Environment
ENVIRONMENT=development  # development, staging, production
DEBUG_MODE=false
DEBUG=false  # Alternative name used by some services
PYTHON_VERSION=3.11

# Security
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET_KEY
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_JWT_SECRET
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Performance & Features
ENABLE_CACHE=true
USE_CACHE=true  # Alternative name
CACHE_TTL=3600  # seconds
CACHE_TTL_SECONDS=300.0  # For client_mcp (5 minutes)

ENABLE_METRICS=true
ENABLE_VALIDATION=true
ENABLE_FALLBACK=true
FALLBACK_MAX_DEPTH=2

# Rate Limiting (Application Level)
RATE_LIMIT_ENABLED=true
USE_RATE_LIMITING=true  # Alternative name
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Health Checks
ENABLE_HEALTH_CHECKS=true

# ============================================================================
# 6. LOGGING CONFIGURATION (All Services)
# ============================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# File Logging
LOG_TO_FILE=true
LOG_FORMAT=json  # json or plain
LOG_DIR=./logs
LOG_DIR_PATH=./logs  # Alternative name

# Log Rotation
LOG_MAX_SIZE=10485760  # 10MB in bytes
LOG_MAX_SIZE_MB=10     # 10MB (mcp_server format)
LOG_BACKUP_COUNT=5

# ============================================================================
# 7. METRICS & OBSERVABILITY
# ============================================================================
ENABLE_METRICS=true
METRICS_EXPORT_PATH=data/execution_metrics.json

# Prometheus (Optional)
PROMETHEUS_PORT=9090

# Tracing (Optional)
ENABLE_TRACING=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ============================================================================
# 8. DOCKER COMPOSE CONFIGURATION
# ============================================================================
DOCKER_NETWORK=lab01_network
POSTGRES_CONTAINER_NAME=lab01_postgres
PGADMIN_CONTAINER_NAME=lab01_pgadmin

# PGAdmin (Development Tool)
PGADMIN_EMAIL=admin@lab01.local
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
PGADMIN_PORT=5050

# Redis (Optional - profile: cache)
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379

# ============================================================================
# 9. CLIENT_MCP ADVANCED CONFIGURATION
# ============================================================================

# Tool Execution
MAX_FUNCTION_CALLS=5
TOOL_TIMEOUT=30

# Retry Strategy
ENABLE_RETRY=true
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=100.0
RETRY_MAX_DELAY_MS=5000.0
RETRY_EXPONENTIAL_BASE=2.0
RETRY_JITTER=true

# Thinking Mode (Gemini 2.5+ only)
ENABLE_THINKING=true
THINKING_BUDGET=1024  # -1=auto, 0=off, >0=fixed tokens
INCLUDE_THOUGHTS=false  # true for debugging, false for production

# Context Caching (Gemini 1.5+)
ENABLE_CONTEXT_CACHING=true
CACHE_TTL_MINUTES=60  # 1 hour (development), 240-480 (production)

# Pagination
PAGINATION_PAGE_SIZE=4  # Products per page
PAGINATION_PERSISTENCE_ENABLED=false
PAGINATION_DB_HOST=localhost
PAGINATION_DB_PORT=5434
PAGINATION_DB_NAME=mcpdb
PAGINATION_DB_USER=mcp_user
PAGINATION_DB_PASSWORD=mcp_password
PAGINATION_TTL_HOURS=24

# Sanitization
SANITIZE_INPUTS=true

# ============================================================================
# 10. FEATURE FLAGS
# ============================================================================
ENABLE_ADVANCED_SEARCH=true
ENABLE_SEMANTIC_SEARCH=true
ENABLE_MULTI_LANGUAGE=false
ENABLE_VOICE_INTERFACE=false

# Multi-Agent System (NEW)
ENABLE_AGENT_ROUTING=true  # Enable multi-agent routing (sales, booking, general)
ROUTER_TEMPERATURE=0.0      # Temperature for intent classification (deterministic)

# ============================================================================
# 11. GOOGLE CALENDAR API (Booking System)
# ============================================================================
# Get service account credentials from Google Cloud Console:
# 1. Create project: https://console.cloud.google.com/
# 2. Enable Calendar API
# 3. Create Service Account
# 4. Download JSON credentials
# 5. Share calendar with service account email

# Google Calendar Integration
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials/service-account.json
GOOGLE_CALENDAR_ID=primary  # Or specific calendar ID
GOOGLE_CALENDAR_TIMEZONE=America/New_York

# Booking Configuration
BOOKING_DEFAULT_DURATION_MINUTES=60
BOOKING_SLOT_INTERVAL_MINUTES=30
BOOKING_ADVANCE_BOOKING_DAYS=30
BOOKING_MIN_ADVANCE_HOURS=2  # Minimum hours before booking
BOOKING_MAX_DAILY_APPOINTMENTS=10

# Notifications
BOOKING_NOTIFICATION_EMAIL_ENABLED=false
BOOKING_SEND_REMINDERS=true
BOOKING_REMINDER_MINUTES_BEFORE=30,10  # Comma-separated list

# ============================================================================
# 12. EXTERNAL SERVICES (Optional)
# ============================================================================

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# Elasticsearch (for advanced search)
ELASTICSEARCH_URL=http://localhost:9200

# S3 (for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# Future AI Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ============================================================================
# 12. DEVELOPMENT & TESTING
# ============================================================================

# Testing
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5434/test_db
PYTEST_COVERAGE_THRESHOLD=80

# Hot Reload
RELOAD_ON_CHANGE=true
WATCH_DIRECTORIES=./src,./agent

# Mock Services
USE_MOCK_MCP=false
USE_MOCK_DATABASE=false

# ============================================================================
# CONFIGURATION NOTES
# ============================================================================
#
# SERVICE-SPECIFIC .env FILES:
# - mcp_server/.env      - For MCP server standalone development
# - client_mcp/.env      - For client standalone development
# - agent/.env           - For agent standalone development
#
# THIS FILE (.env in root):
# - Used by Docker Compose to configure all services
# - Provides defaults for all environment variables
# - Should contain ALL variables from all services
#
# PRIORITY:
# 1. Docker Compose uses variables from THIS file (root .env)
# 2. Individual services can override with their own .env files
# 3. Environment variables in shell override both
#
# SECURITY REMINDERS:
# - NEVER commit .env files to Git
# - Change all CHANGE_ME_* placeholders
# - Use strong passwords (min 16 characters, mixed case, numbers, symbols)
# - Regenerate SECRET_KEY and JWT_SECRET for production
# - Get Google API key from: https://aistudio.google.com/app/apikey
#
# DOCUMENTATION:
# - See docs/MIGRATION_PYDANTIC_V2.md for variable naming conventions
# - See DockerConfig/README.md for Docker setup
# - See individual .env.example files for service-specific details
#
# VARIABLE NAMING:
# - Post Pydantic v2 migration: UPPER_CASE for constants
# - Some legacy snake_case names kept for compatibility
# - Both formats supported in most services
#
# ============================================================================
# END OF CONFIGURATION
# ============================================================================