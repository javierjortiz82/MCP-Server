# --------------------------
# PostgreSQL (obligatorio)
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_db
# Ej: postgresql://postgres:miPassSegura@localhost:5432/mydb
DATABASE_URL=postgresql://mcp_user:mcp_password@localhost:5434/mcpdb

# --------------------------
# Google ADK / Gemini (obligatorio)
# Clave de API para usar google.genai (gemini-embedding-001)
# ¿Dónde obtenerla?
#   1. Ve a https://aistudio.google.com/app/apikey
#   2. Haz clic en "Create API Key"
#   3. Google generará una nueva clave API
#   4. Copia la clave y reemplaza 'YOUR_GOOGLE_API_KEY_HERE' aquí
# IMPORTANTE: Nunca compartas tu API key en repositorios públicos
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# Modelo de embeddings a usar (opcional, por defecto en el código: gemini-embedding-001)
EMBEDDING_MODEL=gemini-embedding-001 #español e ingles

# --------------------------
# Parámetros del proceso (opcional)
# Tamaño de lote para llamadas / generación local
BATCH_SIZE=8

# Número de listas IVF para pgvector (opcional, por defecto 100)
# Más listas = búsquedas más rápidas pero más uso de memoria
PGVECTOR_IVF_LISTS=100

# --------------------------
# Base de datos (opcional)
# Nombre del schema a usar en PostgreSQL
SCHEMA_NAME=test

# --------------------------
# Sistema de Logs (opcional)
# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Tamaño máximo de archivo de log en MB
LOG_MAX_SIZE_MB=10

# Número de archivos de backup a mantener
LOG_BACKUP_COUNT=5

# Directorio de logs (relativo al MCP/)
LOG_DIR=logs

# --------------------------
# Google Calendar Integration (opcional)
# Habilitar integración con Google Calendar para reservas
GOOGLE_CALENDAR_ENABLED=true

# Ruta a las credenciales de cuenta de servicio
# ¿Cómo obtener las credenciales?
#   1. Ve a https://console.cloud.google.com/
#   2. Selecciona o crea un proyecto
#   3. Habilita "Google Calendar API" en APIs & Services > Library
#   4. Ve a APIs & Services > Credentials > Create Credentials > Service Account
#   5. Dale un nombre (ej: mcp-calendar-service) y rol "Project > Editor"
#   6. En la cuenta de servicio creada, ve a Keys > Add Key > Create New Key > JSON
#   7. Descarga el archivo JSON y guárdalo en credentials/service-account.json
#   8. IMPORTANTE: Comparte tu calendario con el email de la cuenta de servicio
#      (ej: mcp-calendar@tu-proyecto.iam.gserviceaccount.com) con permisos de editor
# SEGURIDAD: Agrega credentials/ a .gitignore para no subir las credenciales a Git
GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials/service-account.json

# ID del calendario a usar
# ⚠️  IMPORTANTE: NO usar "primary" con service accounts
#     Si usas "primary", los eventos se crearán en el calendario del service account,
#     no en tu calendario personal.
#
# ✅ USA: Tu email personal (ej: tu-email@gmail.com)
#    BENEFICIO: Los eventos aparecerán en tu calendario personal
#
# Pasos para encontrar tu Calendar ID:
# 1. Ve a https://calendar.google.com/
# 2. Haz clic en ⋮ (tres puntos) junto a "Mi calendario"
# 3. Selecciona "Configuración"
# 4. Busca "ID del calendario" en la sección "Integrar calendario"
# 5. Copia ese ID o usa directamente tu email
GOOGLE_CALENDAR_ID=tu-email@gmail.com

# Zona horaria para eventos y verificación de disponibilidad
GOOGLE_CALENDAR_TIMEZONE=America/Costa_Rica

# --------------------------
# Configuración de Reservas (opcional)
# Duración predeterminada de citas en minutos (por defecto: 60)
BOOKING_DEFAULT_DURATION_MINUTES=60

# Intervalo de slots disponibles en minutos (por defecto: 30)
BOOKING_SLOT_INTERVAL_MINUTES=30

# Máximo de días en el futuro para reservar (por defecto: 30)
BOOKING_ADVANCE_BOOKING_DAYS=30

# Mínimo de minutos de anticipación requeridos para reservar (por defecto: 60)
BOOKING_MIN_ADVANCE_MINUTES=60

# Máximo de citas por día (por defecto: 10)
BOOKING_MAX_DAILY_APPOINTMENTS=10

# --------------------------
# Configuración de Confianza - Parsing de Entrada de Reservas (opcional)
# IMPORTANTE: Valores ajustados en base a análisis de bugs (Issue 2.1)
# Umbral de confianza para clasificación reschedule/cancel (por defecto: 0.75 - aumentado de 0.6)
BOOKING_CHOICE_CONFIDENCE_THRESHOLD=0.75

# Confianza para coincidencias parciales de palabras (por defecto: 0.95)
BOOKING_PARTIAL_MATCH_CONFIDENCE=0.95

# Longitud mínima para substring matching (por defecto: 3)
BOOKING_MIN_KEYWORD_LENGTH=3

# Umbral de coincidencia difusa SequenceMatcher (por defecto: 0.75)
BOOKING_FUZZY_MATCH_THRESHOLD=0.75

# Umbral de confianza para confirmación sí/no (por defecto: 0.75 - aumentado de 0.6)
BOOKING_CONFIRMATION_THRESHOLD=0.75

# Umbral de confianza para solicitar clarificación (por defecto: 0.6)
BOOKING_CLARIFICATION_THRESHOLD=0.6

# Prioridad en la cola de correo para notificaciones de reservas (1-10, por defecto: 5)
BOOKING_EMAIL_QUEUE_PRIORITY=5

# --------------------------
# Configuración de Memoria del Agente (opcional)
# Habilitar sistema de memoria persistente para contexto multi-agente
MEMORY_ENABLED=true

# TTL (vida útil) de bloques de memoria en días (por defecto: 90)
MEMORY_TTL_DAYS=90

# Máximo de turnos de conversación a mantener en memoria a corto plazo (por defecto: 10)
MEMORY_MAX_HISTORY_TURNS=10

# Habilitar extracción semántica de memoria basada en LLM (por defecto: true)
MEMORY_SEMANTIC_EXTRACTION_ENABLED=true

# Habilitar limpieza automática de bloques de memoria expirados (por defecto: true)
MEMORY_AUTO_CLEANUP_ENABLED=true

# Puntuación mínima de prioridad (0-10) para persistir bloque de memoria (por defecto: 5)
MEMORY_PRIORITY_THRESHOLD=5

# Umbral de prioridad para bloques de alta prioridad (por defecto: 7)
MEMORY_PRIORITY_HIGH_THRESHOLD=7

# Puntuación mínima de prioridad para bloques de media prioridad (por defecto: 5)
MEMORY_PRIORITY_MEDIUM_MIN=5

# Puntuación máxima de prioridad para bloques de media prioridad (por defecto: 7)
MEMORY_PRIORITY_MEDIUM_MAX=7

# Número máximo de bloques de alta prioridad en contexto (por defecto: 3)
MEMORY_HIGH_PRIORITY_LIMIT=3

# Número máximo de bloques de media prioridad en contexto (por defecto: 2)
MEMORY_MEDIUM_PRIORITY_LIMIT=2

# Número máximo de bloques de memoria a nivel usuario en contexto (por defecto: 5)
MEMORY_USER_BLOCKS_LIMIT=5

# --------------------------
# Configuración del Ciclo de Vida de Sesiones (opcional)
# Cumplimiento GDPR & Optimización de Rendimiento

# Días de inactividad antes de archivar sesión (excluir de consultas) (por defecto: 90)
SESSION_SOFT_ARCHIVE_DAYS=90

# Días después del archivado antes de eliminación permanente (por defecto: 365)
SESSION_HARD_DELETE_DAYS=365

# Mantener sesiones con customer_email más tiempo para continuidad CRM (por defecto: 180)
SESSION_PRESERVE_WITH_EMAIL_DAYS=180

# Eliminar sesiones anónimas (sin email) más rápido - bajo valor comercial (por defecto: 30)
SESSION_ANONYMOUS_DELETE_DAYS=30