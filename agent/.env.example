# ============================================================================
# Gemini Agent - Environment Configuration (Template)
# ============================================================================
# Este archivo sirve como plantilla para la configuración del servicio Gemini Agent.
#
# IMPORTANTE:
# 1. NO edites este archivo directamente
# 2. Copia este archivo a .env:
#    cp .env.example .env
# 3. Edita .env con tus configuraciones personales
# 4. El archivo .env está en .gitignore (nunca se subirá a Git)
#
# PROPÓSITO:
# Este servicio proporciona una capa separada de AI usando Google Gemini,
# diseñado para arquitecturas distribuidas donde el agente AI se ejecuta
# como un servicio independiente.

# ============================================================================
# GOOGLE GEMINI API CONFIGURATION
# ============================================================================
# Get your API key from: https://aistudio.google.com/app/apikey
# This is REQUIRED for the agent to function
GOOGLE_API_KEY=your_google_api_key_here

# ============================================================================
# MODEL CONFIGURATION
# ============================================================================
# Gemini model to use for AI generation
# Options: gemini-2.5-flash (latest with extended thinking), gemini-1.5-pro
MODEL=gemini-2.5-flash

# ============================================================================
# GENERATION PARAMETERS
# ============================================================================
# Temperature controls randomness (0.0 = deterministic, 2.0 = very random)
# Lower values are better for factual responses
TEMPERATURE=0.3

# Top-K sampling: Number of highest probability tokens to consider
# Higher values = more diversity
TOP_K=40

# Top-P (nucleus) sampling: Cumulative probability threshold
# Lower values = more focused responses
TOP_P=0.9

# Maximum number of tokens to generate in response
MAX_OUTPUT_TOKENS=8192

# Thinking budget for Gemini 2.5 models (only for booking agent with extended thinking)
# 0 = disabled (no thinking), 1024 = simple tasks, 8192+ = complex reasoning
# Controls how many tokens the model uses for internal reasoning before generating response
# Higher values = better reasoning but slower responses and higher costs
# Recommendation: 1024 for most booking tasks, 4096 for complex scheduling
BOOKING_THINKING_BUDGET=1024

# ============================================================================
# SERVICE CONFIGURATION
# ============================================================================
# Port where the agent service will listen
# Default: 8000
AGENT_PORT=8000

# Host to bind to (use 0.0.0.0 for Docker, localhost for local dev)
AGENT_HOST=0.0.0.0

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable file logging (true/false)
LOG_TO_FILE=true

# Directory for log files (relative to agent/)
LOG_DIR=logs

# Maximum log file size in megabytes
LOG_MAX_SIZE_MB=10

# Number of backup log files to keep
LOG_BACKUP_COUNT=5

# ============================================================================
# PERFORMANCE CONFIGURATION (Optional)
# ============================================================================
# Request timeout in seconds
REQUEST_TIMEOUT=30

# Maximum concurrent requests
MAX_CONCURRENT_REQUESTS=10

# Enable request rate limiting (true/false)
ENABLE_RATE_LIMITING=false

# ============================================================================
# CORS CONFIGURATION (Optional)
# ============================================================================
# Allowed origins for CORS (comma-separated)
# Use "*" to allow all origins (development only!)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# INSTRUCCIONES DE USO
# ============================================================================
# 1. Copia este archivo a .env:
#    cp .env.example .env
#
# 2. Obtén tu Google API key desde: https://aistudio.google.com/app/apikey
#    Reemplaza 'your_google_api_key_here' con tu API key real
#
# 3. Ajusta los valores según tu necesidad (ver configuraciones recomendadas abajo)
#
# 4. NUNCA subas .env a Git (ya está en .gitignore)
#
# 5. Para ejecutar el servicio:
#    python -m uvicorn health:app --host 0.0.0.0 --port 8000

# ============================================================================
# RECOMMENDED CONFIGURATIONS
# ============================================================================

# DEVELOPMENT ENVIRONMENT
# -----------------------
# LOG_LEVEL=DEBUG
# AGENT_HOST=localhost
# AGENT_PORT=8000
# ENABLE_RATE_LIMITING=false

# PRODUCTION ENVIRONMENT
# ----------------------
# LOG_LEVEL=INFO
# AGENT_HOST=0.0.0.0
# AGENT_PORT=8000
# ENABLE_RATE_LIMITING=true
# MAX_CONCURRENT_REQUESTS=50
# REQUEST_TIMEOUT=60

# DOCKER DEPLOYMENT
# -----------------
# AGENT_HOST=0.0.0.0
# LOG_TO_FILE=true
# LOG_DIR=/app/logs  # Will be mounted as volume
