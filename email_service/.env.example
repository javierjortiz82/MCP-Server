# Email Service Configuration
# Copy this file to .env and update with your actual values

# ========================================================================
# Database Configuration
# ========================================================================
# PostgreSQL connection string for email queue
DATABASE_URL=postgresql://mcp_user:mcp_password@localhost:5434/mcpdb

# PostgreSQL schema containing email_queue table
SCHEMA_NAME=test

# ========================================================================
# SMTP Configuration
# ========================================================================
# SMTP server hostname (e.g., smtp.gmail.com, smtp.sendgrid.net)
SMTP_HOST=smtp.gmail.com

# SMTP server port (typically 25, 587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP authentication username
SMTP_USER=your-email@gmail.com

# SMTP authentication password or app password
# For Gmail: Use an App Password (not your regular password)
#   1. Enable 2FA on your Google Account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Select "Mail" and "Windows/Linux (o tu sistema)"
#   4. Google will generate a 16-character password
#   5. Paste that password here (sin espacios)
# For other providers: Use your SMTP account password or provider's API key
SMTP_PASSWORD=your-app-password

# Sender email address
SMTP_FROM_EMAIL=noreply@lab01.com

# Sender display name
SMTP_FROM_NAME=Lab01 Bookings

# Use TLS encryption (recommended: true)
SMTP_USE_TLS=true

# SMTP connection timeout in seconds (5-300)
SMTP_TIMEOUT=30

# ========================================================================
# Email Worker Configuration
# ========================================================================
# Seconds between queue polls (1-3600)
EMAIL_WORKER_POLL_INTERVAL=10

# Max emails per batch (1-1000)
EMAIL_WORKER_BATCH_SIZE=50

# Maximum retry attempts (1-10)
EMAIL_RETRY_MAX_ATTEMPTS=3

# Initial backoff duration in seconds (60-86400)
EMAIL_RETRY_BACKOFF_SECONDS=300

# ========================================================================
# Reminder Configuration
# ========================================================================
# Enable 24-hour appointment reminders (true/false)
REMINDER_24H_ENABLED=true

# Enable 1-hour appointment reminders (true/false)
REMINDER_1H_ENABLED=true

# 24-hour reminder subject line
REMINDER_24H_SUBJECT=Recordatorio: Cita mañana

# 1-hour reminder subject line
REMINDER_1H_SUBJECT=Recordatorio: Cita en 1 hora

# ========================================================================
# Logging Configuration
# ========================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Whether to log to file (true/false)
LOG_TO_FILE=true

# Directory for log files
LOG_DIR=./logs

# Maximum log file size in megabytes (default: 10)
LOG_MAX_SIZE_MB=10

# Number of backup log files to keep (default: 5)
LOG_BACKUP_COUNT=5

# ========================================================================
# Template Configuration
# ========================================================================
# Directory containing Jinja2 email templates
# Default: <email_service>/templates
TEMPLATE_DIR=./email_service/templates
