# ============================================================================
# Lab01-MCP Client Configuration (Template)
# ============================================================================
# Environment configuration template for the MCP client application.
#
# USAGE:
#   1. Copy this file to .env:
#      cp .env.example .env
#
#   2. Update variables with your actual values:
#      - Change CHANGE_ME_STRONG_PASSWORD
#      - Set GOOGLE_API_KEY from https://aistudio.google.com/app/apikey
#
#   3. NEVER commit .env to Git (already in .gitignore)
#
# HOW IT WORKS:
#   - Pydantic BaseSettings v2 automatically loads values from .env
#   - Type validation and conversion is automatic (str → int, float, bool)
#   - If a variable is not in .env, the default from settings.py is used
#   - Environment variables take precedence over .env
#
# STRUCTURE:
#   - All configurations are organized by functional area
#   - Each variable has explanatory comments
#   - Values shown are recommended for production
#

# ============================================================================
# 1. GOOGLE GEMINI API CONFIGURATION (Required)
# ============================================================================
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Model Selection (Gemini 2.5+ recommended for latest features)
MODEL=gemini-2.5-flash

# AI Generation Parameters
TEMPERATURE=0.2                    # Range: 0.0-2.0 (lower = deterministic)
TOP_K=40                           # Range: 1-100 (diversity control)
TOP_P=0.95                         # Range: 0.0-1.0 (nucleus sampling)
MAX_OUTPUT_TOKENS=2048             # Recommended: 2048-4096 for complex queries

# ============================================================================
# 2. POSTGRESQL DATABASE CONFIGURATION (Shared)
# ============================================================================
# All services (mcp_server, email_service, client_mcp) use the same PostgreSQL

# PostgreSQL Connection URL (PRIMARY - Used by all services)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://mcp_user:CHANGE_ME_STRONG_PASSWORD@localhost:5434/mcpdb

# Database Schema Configuration
SCHEMA_NAME=test                   # PostgreSQL schema name (shared across all modules)

# ============================================================================
# 3. MCP SERVER CONFIGURATION
# ============================================================================
MCP_HOST=localhost                 # MCP server host (localhost or Docker service name)
MCP_PORT=8009                      # MCP server port
MCP_HEALTH_CHECK_TIMEOUT=5.0       # Health check timeout in seconds (range: 0.1-60)

# ============================================================================
# 4. APPLICATION LOGGING
# ============================================================================
DEBUG_MODE=false                   # Enable debug mode for verbose logging
ENABLE_LOGGING=true                # Enable logging to console and files
LOG_LEVEL=INFO                     # Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================================================
# 5. TOOL EXECUTION CONFIGURATION
# ============================================================================
MAX_FUNCTION_CALLS=5               # Maximum function calls per request (range: 1-50)
TOOL_TIMEOUT=30                    # Tool execution timeout in seconds (range: 1-300)

# ============================================================================
# 6. VALIDATION & SECURITY CONFIGURATION
# ============================================================================
ENABLE_VALIDATION=true             # Enable Pydantic parameter validation
SANITIZE_INPUTS=true               # Enable input sanitization (SQL injection, XSS prevention)

# ============================================================================
# 7. CACHING CONFIGURATION
# ============================================================================
ENABLE_CACHE=true                  # Enable tool result caching
CACHE_TTL_SECONDS=300.0            # Cache TTL in seconds (300 = 5 minutes)

# ============================================================================
# 8. RETRY & RESILIENCE CONFIGURATION
# ============================================================================
ENABLE_RETRY=true                  # Enable automatic retry on failures
RETRY_MAX_ATTEMPTS=3               # Maximum retry attempts (range: 1-10)
RETRY_INITIAL_DELAY_MS=100.0       # Initial delay in milliseconds (range: 100-60000)
RETRY_MAX_DELAY_MS=5000.0          # Maximum delay in milliseconds
RETRY_EXPONENTIAL_BASE=2.0         # Exponential backoff base (range: 1.1-10.0)
RETRY_JITTER=true                  # Enable jitter to prevent thundering herd

# ============================================================================
# 9. FALLBACK CONFIGURATION
# ============================================================================
ENABLE_FALLBACK=true               # Enable fallback to alternative tools
FALLBACK_MAX_DEPTH=2               # Maximum fallback depth (range: 0-3)

# Error Messages (shown when function calling exhausts iterations)
FALLBACK_ERROR_MESSAGE_ES=No pude generar una respuesta final. Las herramientas se ejecutaron pero no pude procesar el resultado.
FALLBACK_ERROR_MESSAGE_EN=I couldn't generate a final response. Tools were executed but I couldn't process the result.

# ============================================================================
# 10. RATE LIMITING CONFIGURATION
# ============================================================================
ENABLE_RATE_LIMITING=true          # Enable Gemini API rate limiting
GEMINI_RPM_LIMIT=15                # Requests per minute (Free tier: 15)
GEMINI_RPD_LIMIT=1500              # Requests per day (Free tier: 1500)
MAX_CONCURRENT_REQUESTS=3          # Maximum simultaneous API calls (range: 1-10)

# Cache Error Pattern Detection
CACHE_ERROR_PATTERNS=CacheError,RESOURCE_EXHAUSTED,cache
RATE_LIMIT_ERROR_PATTERNS=429,RATE_LIMIT_EXCEEDED,quota

# ============================================================================
# 11. CONTEXT CACHING CONFIGURATION (Gemini 1.5+)
# ============================================================================
# Context caching reduces cost by 4x when reusing long system instructions
ENABLE_CONTEXT_CACHING=true        # Enable context caching feature
CACHE_TTL_MINUTES=60               # Context cache TTL in minutes (range: 1-1440)

# ============================================================================
# 12. GEMINI THINKING MODE (Gemini 2.5+ only)
# ============================================================================
# Extended thinking allows the model to reason through problems before responding
ENABLE_THINKING=true               # Enable thinking/reasoning mode
THINKING_BUDGET=1024               # Tokens for thinking (-1=auto, 0=off, >0=fixed)
INCLUDE_THOUGHTS=false             # Include thought summaries in responses (true=debug, false=production)

# ============================================================================
# 13. METRICS & OBSERVABILITY
# ============================================================================
ENABLE_METRICS=true                # Enable automatic metrics collection
METRICS_EXPORT_PATH=data/execution_metrics.json  # Path to export metrics

# ============================================================================
# 14. PAGINATION CONFIGURATION
# ============================================================================
PAGINATION_PAGE_SIZE=4             # Products shown per page (range: 1-20)

# Pagination keywords for language detection (comma-separated)
PAGINATION_KEYWORDS_ES=más,siguiente,muéstrame,opciones    # Spanish keywords
PAGINATION_KEYWORDS_EN=more,next,show,additional,options   # English keywords

# ============================================================================
# 15. PAGINATION PERSISTENCE (Optional)
# ============================================================================
# Enable PostgreSQL persistence for pagination contexts (survives restarts)
PAGINATION_PERSISTENCE_ENABLED=false

# Connection Pool Configuration (pagination-specific, tunable)
PAGINATION_DB_POOL_MIN=1           # Minimum connections in pool (range: 1-10)
PAGINATION_DB_POOL_MAX=5           # Maximum connections in pool (range: 1-20)

# Pagination Context TTL
PAGINATION_TTL_HOURS=24            # Context expiration time (range: 1-168 hours)

# ============================================================================
# 16. MULTI-AGENT SYSTEM CONFIGURATION
# ============================================================================
ENABLE_AGENT_ROUTING=false         # Enable multi-agent intent classification
ROUTER_TEMPERATURE=0.0             # Intent classification temp (0.0=deterministic, 0.1-0.5=vary)

# ============================================================================
# 17. SALES AGENT CONFIGURATION
# ============================================================================
FUNCTION_CALL_MAX_ITERATIONS=10    # Max iterations for function calling (range: 1-50)
