# ============================================================================
# Odiseo Bot - Environment Configuration (Template)
# ============================================================================
# Este archivo sirve como plantilla para la configuración de variables de entorno.
#
# IMPORTANTE:
# 1. NO edites este archivo directamente
# 2. Copia este archivo a .env:
#    cp .env.example .env
# 3. Edita .env con tus configuraciones personales
# 4. El archivo .env está en .gitignore (nunca se subirá a Git)
#
# CÓMO FUNCIONA:
# - Pydantic BaseSettings v2 carga automáticamente los valores de .env
# - Validación de tipos automática (str → int, float, bool)
# - Si una variable no está en .env, se usa el valor por defecto de settings.py
# - Variables de entorno del sistema tienen precedencia sobre .env
#
# ESTRUCTURA:
# - Todas las configuraciones están organizadas por sección
# - Cada valor tiene comentarios explicativos
# - Los valores mostrados son los recomendados para producción

# ============================================================================
# GOOGLE GEMINI API CONFIGURATION
# ============================================================================
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ============================================================================
# MCP SERVER CONFIGURATION
# ============================================================================
MCP_HOST=localhost
MCP_PORT=8009
# Full URL: http://localhost:8009/mcp

# ============================================================================
# MODEL SETTINGS
# ============================================================================
MODEL=gemini-2.5-flash
TEMPERATURE=0.2
# Maximum output tokens for model responses
# - Default: 2048 (allows complete multi-category responses)
# - For simple queries: 1024 is sufficient
# - For complex queries with multiple products: 2048-4096 recommended
# - Gemini maximum: 8192 tokens
MAX_OUTPUT_TOKENS=2048
TOP_K=40
TOP_P=0.95

# ============================================================================
# TOOL EXECUTION SETTINGS
# ============================================================================
MAX_FUNCTION_CALLS=5
TOOL_TIMEOUT=30

# ============================================================================
# VALIDATION SETTINGS (NEW)
# ============================================================================
# Enable Pydantic parameter validation
ENABLE_VALIDATION=true
# Enable input sanitization (SQL injection, XSS prevention)
SANITIZE_INPUTS=true

# ============================================================================
# CACHE SETTINGS (NEW)
# ============================================================================
# Enable tool caching
ENABLE_CACHE=true
# Cache TTL in seconds (300 = 5 minutes)
CACHE_TTL_SECONDS=300.0

# ============================================================================
# METRICS AND OBSERVABILITY SETTINGS (NEW)
# ============================================================================
# Enable automatic metrics collection
ENABLE_METRICS=true
# Path to export metrics JSON file
METRICS_EXPORT_PATH=data/execution_metrics.json

# ============================================================================
# RETRY STRATEGY SETTINGS (NEW)
# ============================================================================
# Enable automatic retry on failures
ENABLE_RETRY=true
# Maximum retry attempts
RETRY_MAX_ATTEMPTS=3
# Initial retry delay in milliseconds
RETRY_INITIAL_DELAY_MS=100.0
# Maximum retry delay in milliseconds
RETRY_MAX_DELAY_MS=5000.0
# Exponential backoff base
RETRY_EXPONENTIAL_BASE=2.0
# Enable jitter to prevent thundering herd
RETRY_JITTER=true

# ============================================================================
# FALLBACK STRATEGY SETTINGS (NEW)
# ============================================================================
# Enable fallback to alternative tools
ENABLE_FALLBACK=true
# Maximum fallback depth
FALLBACK_MAX_DEPTH=2

# ============================================================================
# CONTEXT CACHING CONFIGURATION (Gemini 1.5+)
# ============================================================================
# Context caching reduces cost by 4x when reusing long system instructions
# across multiple requests. Perfect for chatbots with consistent prompts.
#
# Requirements:
# - Gemini 1.5 Flash: Minimum 1,024 tokens
# - Gemini 1.5 Pro: Minimum 4,096 tokens
# - Our system prompt: ~1,700 tokens ✅
#
# Cost Comparison (Gemini 2.5 Flash):
# - Standard input: $0.075 per 1M tokens
# - Cached input: $0.01875 per 1M tokens (75% savings!)
# - Output: $0.30 per 1M tokens (same)
#
# TTL Guidelines:
# - Development: 60 minutes (frequent prompt changes)
# - Production: 240-480 minutes (stable prompts)
# - Maximum: 1440 minutes (24 hours)
ENABLE_CONTEXT_CACHING=true
CACHE_TTL_MINUTES=60

# ============================================================================
# PAGINATION CONFIGURATION
# ============================================================================
# Number of products to show per page in search results
# Remaining products are shown when user requests "más"/"more"
# Range: 1-20 (default: 4)
PAGINATION_PAGE_SIZE=4

# ============================================================================
# PAGINATION PERSISTENCE CONFIGURATION
# ============================================================================
# Enable PostgreSQL persistence for pagination contexts (survives bot restarts)
# When enabled, pagination contexts are saved to database
# When disabled, contexts only exist in memory (lost on restart)
PAGINATION_PERSISTENCE_ENABLED=false

# PostgreSQL database connection for pagination persistence
# Uses the same PostgreSQL instance as MCP server (port 5434)
PAGINATION_DB_HOST=localhost
PAGINATION_DB_PORT=5434
PAGINATION_DB_NAME=mcpdb
PAGINATION_DB_USER=mcp_user
PAGINATION_DB_PASSWORD=mcp_password

# Pagination context TTL (Time To Live) in hours
# After this time, contexts are automatically deleted
# Range: 1-168 hours (1 hour to 7 days, default: 24 = 1 day)
PAGINATION_TTL_HOURS=24

# ============================================================================
# MULTI-AGENT SYSTEM CONFIGURATION
# ============================================================================
# Enable multi-agent routing with intent classification
# false = Legacy mode (single OdiseoBot handles all queries)
# true = Multi-agent mode (routes to specialized agents: sales, booking, general)
ENABLE_AGENT_ROUTING=false

# Router temperature for intent classification
# 0.0 = deterministic (always same classification)
# 0.1-0.5 = slight variation (recommended for production)
ROUTER_TEMPERATURE=0.0

# Use OdiseoBotV2 (BaseAgent-based) instead of legacy OdiseoBot
# false = Legacy OdiseoBot (backward compatible, production-ready)
# true = OdiseoBotV2 (new architecture, inherits from BaseAgent)
#
# Benefits of OdiseoBotV2:
# - 65% less code duplication (inherits from BaseAgent)
# - Consistent architecture with BookingAgent, GeneralAgent
# - Same features: pagination, thinking, caching, metrics
# - 100% API compatible (drop-in replacement)
#
# Rollout Strategy:
# 1. Keep USE_ODISEO_V2=false (default) for safety
# 2. Run tests: pytest agent/test_odiseo_bot_v2.py -v
# 3. Test in development: USE_ODISEO_V2=true
# 4. Monitor metrics and compare with legacy
# 5. Enable in production when confident
USE_ODISEO_V2=false

# ============================================================================
# THINKING CONFIGURATION (Gemini 2.5+ only)
# ============================================================================
# THINKING MODE: Permite al modelo usar razonamiento interno antes de responder
# Solo disponible en modelos Gemini 2.5+ (gemini-2.5-flash, gemini-2.5-pro)
#
# Enable thinking mode (internal reasoning)
ENABLE_THINKING=true
# Tokens for thinking (-1=auto, 0=off, >0=fixed)
THINKING_BUDGET=1024
# Include thought summaries in responses (for debugging)
INCLUDE_THOUGHTS=false

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================
# Enable rate limiting
ENABLE_RATE_LIMITING=true
# Requests per minute (Free tier: 15)
GEMINI_RPM_LIMIT=15
# Requests per day (Free tier: 1500)
GEMINI_RPD_LIMIT=1500
# Simultaneous requests
MAX_CONCURRENT_REQUESTS=3

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Enable debug mode (verbose logging)
DEBUG_MODE=false
# Enable logging
ENABLE_LOGGING=true
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================================================
# INSTRUCCIONES DE USO
# ============================================================================
# 1. Copia este archivo a .env:
#    cp .env.example .env
#
# 2. Obtén tu Google API key desde: https://aistudio.google.com/app/apikey
#    Reemplaza 'your_google_api_key_here' con tu API key real
#
# 3. Ajusta los valores según tu necesidad (ver configuraciones recomendadas abajo)
#
# 4. NUNCA subas .env a Git (ya está en .gitignore)
#
# 5. Para verificar que todo funciona:
#    python3 -c "from config.settings import settings; print(settings.MODEL)"

# ============================================================================
# RECOMMENDED CONFIGURATIONS
# ============================================================================

# DEVELOPMENT ENVIRONMENT
# -----------------------
# DEBUG_MODE=true
# LOG_LEVEL=DEBUG
# ENABLE_METRICS=true
# CACHE_TTL_SECONDS=60.0

# PRODUCTION ENVIRONMENT
# ----------------------
# DEBUG_MODE=false
# LOG_LEVEL=INFO
# ENABLE_METRICS=true
# CACHE_TTL_SECONDS=600.0
# RETRY_MAX_ATTEMPTS=5
# ENABLE_VALIDATION=true

# PERFORMANCE TUNING
# ------------------
# Low latency:     CACHE_TTL_SECONDS=600.0, RETRY_MAX_ATTEMPTS=2
# High reliability: RETRY_MAX_ATTEMPTS=5, FALLBACK_MAX_DEPTH=3
